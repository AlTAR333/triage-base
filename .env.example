# ---- LLM (any OpenAI-compatible provider; base URL INCLUDES /v1) ----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: USD price per 1M tokens, used to compute cost (0 if free)
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# ---- Decision model (check your provider's docs for the path) ----
DM_BASE_URL=
DM_API_KEY=
DM_MODEL=
DM_PATH=/v1/systemone
DM_PRICE_INPUT_PER_M=0
# dm+llm: the DM answer is kept when confidence >= this, otherwise the LLM takes over
DM_CONFIDENCE_THRESHOLD=0.8
# dm / dm+llm: needs_human_review is true when confidence < this
DM_REVIEW_THRESHOLD=0.7
